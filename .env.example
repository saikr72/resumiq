# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/resume_intelligence

# Python Service
PYTHON_SERVICE_URL=http://localhost:8000

# Anthropic API Key (Required for AI suggestions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=5000
# Authentication
FRONTEND_ORIGIN=http://localhost:3000
# OAuth web client ID from Google Cloud Console. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Set to true when serving over HTTPS
COOKIE_SECURE=false
